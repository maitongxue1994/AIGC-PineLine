{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aigcpineline0419",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-04-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp/*"]
  },
  // 画布桥（外部 Agent MCP ↔ 浏览器 WebSocket 中继）；免费计划要求 SQLite-backed DO。
  // 注意：deploy/cloudflare 分支的 wrangler.jsonc 独立维护，需同步等价配置。
  "durable_objects": {
    "bindings": [{ "name": "CANVAS_BRIDGE", "class_name": "CanvasBridge" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CanvasBridge"] }],
  "observability": {
    "enabled": true
  }
}
